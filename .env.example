# For a physical Android device on the same Wi-Fi as your dev machine,
# replace `localhost` with your machine's LAN IP, e.g. http://192.168.1.42:3000/api/v1
# Find it via: PowerShell `ipconfig` (look for IPv4 Address under Wi-Fi).
# Android emulator users: use http://10.0.2.2:3000/api/v1
# iOS simulator users:    localhost works.
EXPO_PUBLIC_API_URL=http://localhost:3000/api/v1
EXPO_PUBLIC_WS_URL=http://localhost:3000
